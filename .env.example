# altacloset configuration — copy to .env and edit.
# ALL config lives here so the same repo runs unchanged on the target machine.

# --- ports ---
# WEBAPP_BIND=127.0.0.1 (default, loopback only). Set 0.0.0.0 to expose on the
# LAN for testing — only do this behind auth + a trusted network.
WEBAPP_PORT=28082
COMFYUI_PORT=28188
OLLAMA_PORT=28114

# --- auth ---
# SESSION_TTL_DAYS=30          # bearer sessions expire after this many days

# --- weather ---
# WEATHER_SOURCE=openmeteo  (no API key, needs internet) | homeassistant | manual
WEATHER_SOURCE=openmeteo
# Coordinates for Open-Meteo (defaults to San Francisco if unset)
# WEATHER_LAT=37.7749
# WEATHER_LON=-122.4194
# Optional Home Assistant override (LAN). Example:
# HA_URL=http://10.0.1.168:8123
# HA_TOKEN=long-lived-access-token
# HA_WEATHER_ENTITY=weather.home

# --- recommender ---
# OPENWEATHER_API_KEY=            # (unused for MVP; openmeteo needs none)
# --- AI tag-reader (wardrobe upload path — local Ollama, GPU) ---
# OLLAMA_VISION_MODEL=qwen2.5vl:3b   # smallest Ollama VLM that follows instructions + reads tags
# --- stylist chat (DeepSeek API — zero VRAM, keeps GPU free for CatVTON) ---
DEEPSEEK_API_KEY=your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # default
# DEEPSEEK_CHAT_MODEL=deepseek-v4-flash        # default (use deepseek-v4-pro for richer replies)
# --- try-on ---
# MAX_UPLOAD_PX=1024             # downscale incoming images to this
