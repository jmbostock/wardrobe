{
  "1": {
    "class_type": "ImageOnlyCheckpointLoader",
    "inputs": {"ckpt_name": "svd_xt.safetensors"}
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {"image": "SVD_BASE.png"}
  },
  "3": {
    "class_type": "SVD_img2vid_Conditioning",
    "inputs": {
      "clip_vision": ["1", 1],
      "init_image": ["2", 0],
      "vae": ["1", 2],
      "width": 576,
      "height": 1024,
      "video_frames": 25,
      "motion_bucket_id": 30,
      "fps": 6,
      "augmentation_level": 0.0
    }
  },
  "4": {
    "class_type": "VideoLinearCFGGuidance",
    "inputs": {"model": ["1", 0], "min_cfg": 1.0}
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["3", 0],
      "negative": ["3", 1],
      "latent_image": ["3", 2],
      "seed": 42,
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["5", 0], "vae": ["1", 2]}
  },
  "7": {
    "class_type": "SaveAnimatedWEBP",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "svd",
      "fps": 6,
      "lossless": false,
      "quality": 90,
      "method": "default"
    }
  }
}
