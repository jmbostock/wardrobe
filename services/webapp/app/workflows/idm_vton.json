{
  "10": {
    "class_type": "LoadImage",
    "inputs": {"image": "person.png"}
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": {"image": "garment.png"}
  },
  "12": {
    "class_type": "LoadAutoMasker",
    "inputs": {"catvton_path": "zhengchong/CatVTON"}
  },
  "13": {
    "class_type": "AutoMasker",
    "inputs": {
      "pipe": ["12", 0],
      "target_image": ["10", 0],
      "cloth_type": "upper"
    }
  },
  "14": {
    "class_type": "DensePosePreprocessor",
    "inputs": {
      "image": ["10", 0],
      "model": "densepose_r50_fpn_dl.torchscript",
      "cmap": "Viridis (MagicAnimate)",
      "resolution": 512
    }
  },
  "15": {
    "class_type": "PipelineLoader",
    "inputs": {"weight_dtype": "float16"}
  },
  "16": {
    "class_type": "IDM-VTON",
    "inputs": {
      "pipeline": ["15", 0],
      "human_img": ["10", 0],
      "pose_img": ["14", 0],
      "mask_img": ["13", 0],
      "garment_img": ["11", 0],
      "garment_description": "The garment shown in the reference image.",
      "negative_prompt": "lowres, bad anatomy, bad hands, text, error, missing fingers, extra digit, fewer digits, cropped, worst quality, low quality, normal quality, jpeg artifacts, signature, watermark, username, blurry, bad feet",
      "width": 768,
      "height": 1024,
      "num_inference_steps": 30,
      "guidance_scale": 2.0,
      "strength": 1.0,
      "seed": 42
    }
  },
  "17": {
    "class_type": "SaveImage",
    "inputs": {"images": ["16", 0], "filename_prefix": "idm_vton"}
  }
}
